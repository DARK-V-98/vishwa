
rules_version = '2';

// NOTE: To fix CORS errors during development, you may need to apply a cors.json file
// to your bucket. Run `npm run update:cors` from your terminal to do this.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function for admin check
    function isAdmin() {
      // Check if the user has an 'admin' or 'developer' role.
      let isPrimaryAdmin = request.auth.token.email in ['tikfese@gmail.com', 'nelumjayakody2005@gmail.com'];
      return request.auth != null && (isPrimaryAdmin || ('admin' in request.auth.token || 'developer' in request.auth.token));
    }
    
    // Public read for general files, but not course notes
    match /{allPaths=**} {
      allow read: if allPaths.split('/')[0] != 'course-notes';
    }

    // Allow write only for authenticated users on specific public paths
    match /tournaments/{fileName} {
      allow write: if request.auth != null;
    }
    match /testimonials/{fileName} {
      allow write: if request.auth != null;
    }
    match /topup-packages/{fileName} {
      allow write: if request.auth != null;
    }

    // Secure rule for course notes. Read access is handled by signed URLs.
    match /course-notes/{fileName} {
      allow read: if false; // Deny direct public read
      allow write: if isAdmin(); // Only admins can upload notes
    }
  }
}
