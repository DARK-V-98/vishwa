
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // A user is an admin if their email is one of the primary admins,
      // OR if their user document contains an 'admin' or 'developer' role.
      let isPrimaryAdmin = request.auth.token.email == 'tikfese@gmail.com' || request.auth.token.email == 'nelumjayakody2005@gmail.com';
      let hasAdminRole = exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin', 'developer']);
      return isPrimaryAdmin || hasAdminRole;
    }

    // User profiles can be created by the user themselves.
    // Any signed-in user can read profiles (needed for role checks), but only owner/admin can update.
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow get: if isSignedIn();
      allow update: if (isSignedIn() && isOwner(userId)) || isAdmin();
      // Only admins can list all users or delete a user.
      allow list, delete: if isAdmin();
    }

    // User-specific subcollections are only accessible by their owner or an admin.
    match /users/{userId}/{subcollection}/{docId} {
      allow read, write: if (isSignedIn() && isOwner(userId)) || isAdmin();
    }
    
    // Design Orders can be created by any signed-in user, but only managed by admins.
    match /designOrders/{orderId} {
        allow create: if isSignedIn();
        allow read, list, update: if isAdmin();
    }
    
    // Projects collection for quotation generator
    match /projects/{projectId} {
        allow create: if isSignedIn();
        allow read, list, update: if isAdmin();
    }
    
    // WEB ORDERS RULES
    match /webOrders/{orderId} {
      // Admins can manage all orders. Public can read a specific order.
      allow list, create, update, delete: if isAdmin();
      allow get: if true; 
      
      match /details/{docId} {
        // The assigned user or an admin can write the details once.
        allow create: if (isSignedIn() && isOwner(get(/databases/$(database)/documents/webOrders/$(orderId)).data.userId)) || isAdmin();
        // The assigned user or an admin can read the details. Public can read.
        allow read: if true;
        allow update: if (isSignedIn() && isOwner(get(/databases/$(database)/documents/webOrders/$(orderId)).data.userId)) || isAdmin();
      }
      
      match /updates/{updateId} {
        // Only admins can post updates.
        allow create, update, delete: if isAdmin();
        // Public can read updates.
        allow read, list: if true;
      }
    }


    // Services are public to read, but only admins can write.
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Products are public to read.
    // Writes are restricted to the product's seller or an admin.
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Top-up packages are public to read, but only admins can write.
    match /topupPackages/{packageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Anyone can create a top-up order.
    // Only the user who created it or an admin can read/list their own orders.
    // Only admins can update/delete it.
    match /topupOrders/{orderId} {
      allow create: if true;
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin(); // Only admins should list all orders
      allow update, delete: if isAdmin();
    }

    // Global settings are public to read, but only admins can write.
    match /settings/{settingId} {
        allow get: if true;
        allow write: if isAdmin();
    }

    // CHAT RULES
    match /chats/{chatId} {
        allow list: if isAdmin();
        allow get, create, update: if (isSignedIn() && isOwner(chatId)) || isAdmin();
        match /messages/{messageId} {
          allow read, list: if (isSignedIn() && isOwner(chatId)) || isAdmin();
          allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        }
    }
    
    // Testimonials are public to read, but only admins can write.
    match /testimonials/{testimonialId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
    }
    
    // TOURNAMENT RULES
    match /tournaments/{tournamentId} {
      allow get: if resource.data.status == 'published' || (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()));
      allow list: if (request.query.where.size() == 1 && request.query.where[0] == ['status', '==', 'published']) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
      match /teams/{teamId} {
        allow read, list, create, update, delete: if (isSignedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.userId == request.auth.uid) || isAdmin();
      }
    }

    // COURSE NOTES RULES
    match /courseNotes/{noteId} {
      // Only admins can create, update, or delete course notes.
      allow read, list, create, update, delete: if isAdmin();
    }

    match /accessCodes/{codeId} {
      // Allow admins full control over access codes.
      allow read, list, create, update: if isAdmin();
      allow delete: if false; // No client-side delete for codes is needed.
    }
  }
}
